APP_MODE=production
# env_file 不会展开 ${...}，这里必须是实际值；测试默认值与 .env.example 保持一致
DB_CONNECT_URL=mysql://domainadmin:domainadmin123@mysql:3306/data

# 测试默认值；生产环境必须修改为强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ENABLED_REGISTER=true

CACHE_BACKEND=redis
ASYNC_TASK_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=domain_admin
REDIS_CACHE_DB=0
REDIS_ASYNC_DB=1
REDIS_TASK_RESULT_TTL=86400
REDIS_LOCK_TTL=3600

SCHEDULER_ENABLED=false
SCHEDULER_ROLE=none

# optional
# SECRET_KEY=
# PROMETHEUS_KEY=
# ALLOW_COMMANDS=/opt/nginx/sbin/nginx -s reload
