# database
DB_CONNECT_URL=mysql://root:<password>@127.0.0.1:3306/data

# app mode: production / development
APP_MODE=production

# allow commands eg:
ALLOW_COMMANDS=/opt/nginx/sbin/nginx -s reload

# cache backend: diskcache / redis
CACHE_BACKEND=diskcache

# async task backend: local / redis
ASYNC_TASK_BACKEND=local
ASYNC_TASK_QUEUE_NAME=domain-admin

# redis
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=domain_admin
REDIS_CACHE_DB=0
REDIS_ASYNC_DB=1
REDIS_TASK_RESULT_TTL=86400
REDIS_LOCK_TTL=3600

# scheduler
SCHEDULER_ENABLED=true
# all / web / worker / none
SCHEDULER_ROLE=all

# allow user register
ENABLED_REGISTER=true
